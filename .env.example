# LumiField private runtime configuration. Copy to .env; never commit .env.
LF_BOOTSTRAP_ADMIN_EMAILS=admin@example.com,admin-backup@example.com
LF_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Standard SMTP (use the provider's SMTP authorization code, not the mailbox login password).
LF_MAIL_HOST=smtp.example.com
LF_MAIL_PORT=465
LF_MAIL_SECURE=true
LF_MAIL_USER=mailer@example.com
LF_MAIL_PASSWORD=replace-with-smtp-authorization-code
LF_MAIL_FROM=LumiField <mailer@example.com>

# Official OAuth. Redirect URIs must be HTTPS (loopback HTTP is allowed for local development).
LF_WECHAT_APP_ID=replace-with-wechat-open-platform-app-id
LF_WECHAT_APP_SECRET=replace-with-wechat-open-platform-app-secret
LF_WECHAT_REDIRECT_URI=https://account.example.com/v1/auth/oauth/callback
LF_WECHAT_SCOPE=snsapi_login
LF_WECHAT_STATE_SECRET=replace-with-at-least-32-random-characters
LF_WECHAT_REVIEW_STATUS=not_submitted
LF_QQ_APP_ID=replace-with-qq-connect-app-id
LF_QQ_APP_KEY=replace-with-qq-connect-app-key
LF_QQ_REDIRECT_URI=https://account.example.com/v1/auth/oauth/callback
LF_QQ_SCOPE=get_user_info
LF_QQ_STATE_SECRET=replace-with-at-least-32-random-characters
LF_QQ_REVIEW_STATUS=not_submitted

# Public HTTPS LF account service used by the mobile QR confirmation page.
LF_MOBILE_AUTH_URL=https://account.example.com

# Public HTTPS LF API used for expiring feedback-attachment download links in notification emails.
LF_PUBLIC_API_URL=https://account.example.com

# Optional batch lyric translation service. The endpoint must be administrator-controlled HTTPS.
LF_TRANSLATE_ENDPOINT=https://translation.example.com/v1/lyrics
LF_TRANSLATE_API_KEY=replace-with-translation-service-key

# Optional local-only Demucs stem separation runtime and already-downloaded models.
LF_DEMUCS_PATH=C:\path\to\demucs-runtime
LF_DEMUCS_MODEL_DIR=C:\path\to\demucs-model-cache
LF_DEMUCS_FAST_MODEL=mdx_q
LF_DEMUCS_HIGH_MODEL=htdemucs_ft

# Development only. Packaged builds always ignore this switch.
LF_ALLOW_LOCAL_CODES=0
